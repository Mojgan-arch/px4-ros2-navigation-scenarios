<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_navigator</name>
  <version>0.3.0</version>
  <description>
    A catalog of autonomous navigation scenarios for PX4 drones on ROS 2.
    Mission and behaviour nodes are platform-agnostic; all contact with the
    flight controller is isolated in px4_offboard_interface_node.
  </description>
  <maintainer email="YOUR_EMAIL@example.com">YOUR_NAME</maintainer>
  <license>TODO</license>

  <url type="repository">https://github.com/YOUR_USERNAME/px4-ros2-navigation-scenarios</url>
  <url type="bugtracker">https://github.com/YOUR_USERNAME/px4-ros2-navigation-scenarios/issues</url>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_python</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
